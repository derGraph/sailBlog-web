{
  "name": "sailblog",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev --host",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "build-workers": "npm run --prefix workers build",
    "run-workers": "node ./workers/build/workers/index.js",
    "workers": "npm run --prefix workers build && node ./workers/build/workers/index.js",
    "generate": "prisma generate && prettier --config .prettierrc --write prisma/generated",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:e2e": "node scripts/run-tests.mjs e2e",
    "test:all": "node scripts/run-tests.mjs all",
    "test:runtime": "node scripts/docker-smoke.mjs",
    "check:tests": "tsc --project tests/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@skeletonlabs/skeleton": "^5.0.1",
    "@skeletonlabs/skeleton-svelte": "^5.0.1",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-blockquote": "^3.32.0",
    "@tiptap/extension-bullet-list": "^3.32.0",
    "@tiptap/extension-document": "^3.32.0",
    "@tiptap/extension-heading": "^3.32.0",
    "@tiptap/extension-horizontal-rule": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-list-item": "^3.32.0",
    "@tiptap/extension-ordered-list": "^3.32.0",
    "@tiptap/extension-paragraph": "^3.32.0",
    "@tiptap/extension-text": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-typography": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/sax": "^1.2.7",
    "@vitest/coverage-v8": "^5.0.4",
    "autoprefixer": "^10.6.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "utility-types": "^3.11.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "type": "module",
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@turf/turf": "^7.4.0",
    "compression": "^1.8.2",
    "dotenv": "^18.0.8",
    "exif-reader": "^2.0.3",
    "exifr": "^7.1.3",
    "express": "^5.3.0",
    "geolib": "^4.0.0",
    "isomorphic-dompurify": "^4.5.0",
    "pm2": "^7.0.4",
    "prisma": "^7.10.0",
    "sax": "^1.6.1",
    "sharp": "^0.35.5"
  },
  "optionalDependencies": {
    "@types/geojson": "^7946.0.16"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*",
    "#prisma": "./prisma/generated/browser.ts"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    },
    "mysql2": "^3.24.6",
    "mariadb": "^3.5.4",
    "basic-ftp": "^6.2.3",
    "js-yaml": "^4.3.2",
    "postcss-selector-parser": "^7.1.6"
  }
}
