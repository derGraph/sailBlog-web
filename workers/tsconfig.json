{
  "compilerOptions": {
    "outDir": "build",
    "rootDir": "..",
    "noEmitOnError": true,
    "target": "esnext",
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "types": ["node"],
    "rewriteRelativeImportExtensions": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["./*.ts", "../prisma/generated/**/*.ts"]
}
